# Copy to .env and fill in. `.env` is gitignored.
#
#   cp .env.example .env
#   openssl rand -base64 32          # paste as NEXTAUTH_SECRET
#   npx prisma db push               # create the tables
#   npm run dev                      # then open http://localhost:3000/login
#
# On /login, "Explore the demo account" seeds and signs you in immediately.

# Postgres connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dashnotes"

# REQUIRED. next-auth will not start in production without this, and every
# /api/auth/* route returns 500 if it is missing. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-random-32-byte-value"

# Full URL including the scheme. Locally this must be http:// — next-auth
# assumes https when the scheme is absent, which breaks local redirects.
NEXTAUTH_URL="http://localhost:3000"

# Shared demo account on the login page. Read at runtime, so changing it takes
# effect on restart without a rebuild. Defaults to enabled; set to "false" to
# close both the login button and /api/demo before the app has real users.
ENABLE_DEMO_LOGIN="true"

# Optional. Powers Ask Feynman, summaries, flashcards and quizzes; those
# endpoints return 500 without it. The rest of the app, including handwriting,
# works fine without one.
PERPLEXITY_API_KEY=""

# Optional. Only needed for the subscription flow.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
